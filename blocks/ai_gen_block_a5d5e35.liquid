{% doc %}
  @prompt
    Create grid with 3 items. 2 columns with left column 50% height with two items. add admin for theme colour settings. Make the left column and top right block image based with text and button links. Make the bottom right block have an email signup using shopify's existing email block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top:40px;
    padding-bottom:40px;
  }

  .ai-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    
  }

  .ai-grid-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background-color: {{ block.settings.item_background_color }};
  }

  .ai-grid-item-{{ ai_gen_id }}:before {
    position: absolute;
    bottom:0;
    left:0;
    width:100%;
    height:40%;
    content: '';
    display:block;
    z-index:1;
    pointer-events:none;
    background: linear-gradient(0deg,rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 100%);
  }

  .ai-grid-item-{{ ai_gen_id }}--left {
    grid-row: 1 / 3;
  }

  .ai-grid-item-{{ ai_gen_id }}--top-right {
    height: {{ block.settings.grid_height }}px;
    grid-row: 1 / 2;
  }

  .ai-grid-item-{{ ai_gen_id }}--bottom-right {
    grid-row: 2 / 3;
    align-items: center;
  }

  .ai-grid-item-{{ ai_gen_id }}--bottom-right:before {
    display:none;
  }

  .ai-grid-item-{{ ai_gen_id }}--left:hover {
    img {
      transform: scale(1.02);
    }      
  }
  .ai-grid-item-{{ ai_gen_id }}--top-right:hover {
    img {
      transform: scale(1.05);
    }      
  } 

  .ai-grid-item-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index:0;
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .ai-grid-item-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-grid-item-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-grid-item-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    text-align: left;
    padding: 40px;
    width: 100%;
  }

  .ai-grid-item-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-grid-item-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 0px;
  }

  .ai-grid-item-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.05em;
    transition: background-color 0.3s ease;
  }

  .ai-grid-item-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-grid-email-form-{{ ai_gen_id }} {
    padding: 40px;
    background-color: {{ block.settings.email_background_color }};
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .ai-grid-email-heading-{{ ai_gen_id }} {
    color: {{ block.settings.email_text_color }};
    font-size: {{ block.settings.email_heading_size }}px;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-grid-email-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.email_text_color }};
    font-size: {{ block.settings.email_text_size }}px;
    text-align:center;
    max-width: 500px;
    margin: 0;
  }

  .ai-grid-email-field-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 400px;
  }

  .ai-grid-email-input-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.email_input_border }};
    border-radius: 0;
    background-color: {{ block.settings.email_input_background }};
    color: {{ block.settings.email_text_color }};
  }

  .ai-grid-email-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.email_button_bg }};
    color: {{ block.settings.email_button_color }};
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.05em;
    transition: background-color 0.3s ease;
  }

  .ai-grid-email-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.email_button_hover }};
  }

  .ai-grid-email-success-{{ ai_gen_id }} {
    color: {{ block.settings.email_success_color }};
    margin-top: 8px;
  }

  .ai-grid-email-error-{{ ai_gen_id }} {
    color: {{ block.settings.email_error_color }};
    margin-top: 8px;
  }

  @media screen and (max-width: 749px) {
    .ai-grid-container-{{ ai_gen_id }} {
      padding-top:20px;
      padding-bottom:20px;
    }

    .ai-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 20px;
      height: auto;
    }

    .ai-grid-item-{{ ai_gen_id }}--left {
      grid-row: auto;
      min-height: 400px;
    }

    .ai-grid-item-{{ ai_gen_id }}--top-right {
      grid-row: auto;
      min-height: 300px;
      height:auto;
    }

    .ai-grid-item-{{ ai_gen_id }}--bottom-right {
      grid-row: auto;
      min-height: 300px;
      
    }

    .ai-grid-item-content-{{ ai_gen_id }} {
      padding: 24px;
      text-align:center;
    }

    .ai-grid-email-form-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-grid-email-field-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<div class="ai-grid-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-grid-{{ ai_gen_id }}">
    <div class="ai-grid-item-{{ ai_gen_id }} ai-grid-item-{{ ai_gen_id }}--left">
      {% if block.settings.left_button_text != blank and block.settings.left_button_link != blank %}
          <a href="{{ block.settings.left_button_link }}">
        {% endif %}
      {% if block.settings.left_image %}
        <img
          src="{{ block.settings.left_image | image_url: width: 1200 }}"
          alt="{{ block.settings.left_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.left_image.width }}"
          height="{{ block.settings.left_image.height }}"
          class="ai-grid-item-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-grid-item-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-grid-item-content-{{ ai_gen_id }}">
        {% if block.settings.left_heading != blank %}
          <h2 class="ai-grid-item-heading-{{ ai_gen_id }}">{{ block.settings.left_heading }}</h2>
        {% endif %}
        {% if block.settings.left_text != blank %}
          <div class="ai-grid-item-text-{{ ai_gen_id }}">{{ block.settings.left_text }}</div>
        {% endif %}
        {% if block.settings.left_button_text != blank and block.settings.left_button_link != blank %}
          <a href="{{ block.settings.left_button_link }}" class="ai-grid-item-button-{{ ai_gen_id }}" style="display:none;">
            {{ block.settings.left_button_text }}
          </a>
        {% endif %}
      </div>
      {% if block.settings.left_button_text != blank and block.settings.left_button_link != blank %}
          </a>
        {% endif %}
    </div>

    <div class="ai-grid-item-{{ ai_gen_id }} ai-grid-item-{{ ai_gen_id }}--top-right">
    {% if block.settings.left_button_text != blank and block.settings.left_button_link != blank %}
          <a href="{{ block.settings.top_right_button_link }}">
        {% endif %}
      {% if block.settings.top_right_image %}
        <img
          src="{{ block.settings.top_right_image | image_url: width: 800 }}"
          alt="{{ block.settings.top_right_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.top_right_image.width }}"
          height="{{ block.settings.top_right_image.height }}"
          class="ai-grid-item-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-grid-item-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-grid-item-content-{{ ai_gen_id }}">
        {% if block.settings.top_right_heading != blank %}
          <h2 class="ai-grid-item-heading-{{ ai_gen_id }}">{{ block.settings.top_right_heading }}</h2>
        {% endif %}
        {% if block.settings.top_right_text != blank %}
          <div class="ai-grid-item-text-{{ ai_gen_id }}">{{ block.settings.top_right_text }}</div>
        {% endif %}
        {% if block.settings.top_right_button_text != blank and block.settings.top_right_button_link != blank %}
          <a href="{{ block.settings.top_right_button_link }}" class="ai-grid-item-button-{{ ai_gen_id }}" style="display:none;">
            {{ block.settings.top_right_button_text }}
          </a>
        {% endif %}
      </div>
      {% if block.settings.left_button_text != blank and block.settings.left_button_link != blank %}
          </a>
        {% endif %}
    </div>

    <div class="ai-grid-item-{{ ai_gen_id }} ai-grid-item-{{ ai_gen_id }}--bottom-right">
      {%- form 'contact' -%}
        <div class="ai-grid-email-form-{{ ai_gen_id }}">
          {% if block.settings.email_heading != blank %}
            <h3 class="ai-grid-email-heading-{{ ai_gen_id }}">{{ block.settings.email_heading }}</h3>
          {% endif %}
          {% if block.settings.email_subtext != blank %}
            <div class="ai-grid-email-subtext-{{ ai_gen_id }}">{{ block.settings.email_subtext }}</div>
          {% endif %}
          <div class="ai-grid-email-field-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="ai-grid-email-input-{{ ai_gen_id }}"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-grid-email-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-grid-email-success-{{ ai_gen_id }}"
              {% endif %}
              placeholder="{{ block.settings.email_placeholder }}"
              required
            >
            <button type="submit" class="ai-grid-email-button-{{ ai_gen_id }}">
              {{ block.settings.email_submit_text }}
            </button>
          </div>
          {%- if form.errors -%}
            <div id="ai-grid-email-error-{{ ai_gen_id }}" class="ai-grid-email-error-{{ ai_gen_id }}">
              <span>{{ form.errors.messages.email }}</span>
            </div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <div id="ai-grid-email-success-{{ ai_gen_id }}" class="ai-grid-email-success-{{ ai_gen_id }}">
              <span>{{ block.settings.email_success_message }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
